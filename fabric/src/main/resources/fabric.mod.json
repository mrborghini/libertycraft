{
  "schemaVersion": 1,
  "id": "libertycraft",
  "version": "${version}",
  "name": "LibertyCraft",
  "description": "Play GTA IV with Minecraft physics, inventory and viewmodels. A port of SkyCraft.",
  "authors": ["LibertyCraft contributors"],
  "contributors": ["chasmlol (SkyCraft, MIT, https://github.com/chasmlol/SkyCraft)"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": ["dev.libertycraft.LibertyCraft"],
    "client": ["dev.libertycraft.client.LibertyCraftClient"]
  },
  "mixins": [
    "libertycraft.mixins.json",
    { "config": "libertycraft.client.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
